MONGODB_URI=
MONGODB_DB_NAME=softabyte_labs

# Upstash Redis — shared contact-form rate limiting (server-side only)
# Required for production rate limiting. Do not use NEXT_PUBLIC_ prefixes.
# Create a Redis database at https://console.upstash.com/ and copy REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
