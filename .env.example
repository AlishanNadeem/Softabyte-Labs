MONGODB_URI=
MONGODB_DB_NAME=softabyte_labs

# Upstash Redis — shared rate limiting (server-side only)
# Used by contact form and Admin login limiters (separate prefixes).
# Do not use NEXT_PUBLIC_ prefixes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin accounts are created with:
#   npm run create-admin
# Do not store Admin passwords in environment files.
